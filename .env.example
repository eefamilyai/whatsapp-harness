# Copy to .env and fill in. Loaded automatically at startup. (install.bat does this for you.)

# ---- LLM: DeepSeek Flash by default (any OpenAI-compatible endpoint with tool calling works) ----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek reasoning: off (default: fastest, cheapest) | low | high | max
LLM_THINKING=off
# Send images to the chat model (deepseek-flash accepts them). Set false for text-only models.
LLM_VISION=true
# Other options:
#   Gemini (free tier):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#   OpenRouter:          LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=deepseek/deepseek-chat-v3.1
#   Local Ollama:        LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b  LLM_API_KEY=ollama

# ---- Optional: voice notes, videos, scanned PDFs ----
# DeepSeek cannot hear or watch. With a Gemini key (aistudio.google.com/apikey, free tier) the bot
# transcribes voice notes, describes videos up to ~18 MB, and reads scanned PDFs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Who may talk to the bot ----
# Empty = "message yourself" mode: the linked WhatsApp account IS you, and only your own
# self-chat is read.
# Set it (digits only, with country code, e.g. 6591234567) if the bot runs on a DIFFERENT
# WhatsApp number from yours: then only messages from that number are read, and replies and
# reminders go to it. This is the setup that makes your phone actually buzz on reminders.
OWNER_NUMBER=
# Used only while linking: the number of the account being linked, to get a pairing code
# instead of a QR code. Digits only, with country code.
PAIRING_NUMBER=

# ---- Behaviour (most of these can also be changed from WhatsApp: send /help) ----
TIMEZONE=Asia/Singapore
DATA_DIR=./data
# confirm = ask "yes/no" on WhatsApp before every shell command (default) | auto | off
SHELL_MODE=confirm
# Working directory for shell commands (default: your home folder)
SHELL_CWD=
# Alarms re-ping every N seconds, up to M times, until you reply "stop"
ALARM_REPEAT_SECONDS=60
ALARM_MAX_PINGS=10
# Ignore messages older than this many minutes (e.g. sent while the bot was offline)
MAX_MESSAGE_AGE_MINUTES=30

# ---- Web search ----
# SearXNG instance with the JSON format enabled. Falls back to DuckDuckGo HTML if unset/failing.
SEARXNG_URL=

# ---- Google Calendar (optional; see README) ----
GOOGLE_CLIENT_FILE=./data/google-client.json
GOOGLE_TOKEN_FILE=./data/google-token.json
GOOGLE_CALENDAR_ID=primary

LOG_LEVEL=info
