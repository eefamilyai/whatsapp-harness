{
  "name": "whatsapp-harness",
  "version": "0.1.0",
  "description": "A personal WhatsApp assistant: Baileys + an LLM tool loop (search, shell, reminders, alarms, Google Calendar).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "package": "node scripts/package-release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "google-auth": "node dist/scripts/google-auth.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "fflate": "^0.8.3",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "unpdf": "^2.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20.12"
  }
}
